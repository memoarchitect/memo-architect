        <mxCell id="p6_sub" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=2;fontColor=#555555;" value="Two-ontology backbone per ADR-1-10: architecture + process bridged by a single modeling profile. Device project imports the profile."><mxGeometry x="40" y="56" width="1420" height="22" as="geometry"/></mxCell>

        <!-- Top row: arch + process -->
        <mxCell id="p6_arch" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" value="@memo/ontology-arch&#10;&#10;11-layer MBSE backbone (ISO 42010)&#10;Operational · Behavioral · Functional · Logical · Software (+ Software-Extension/ROS) · Hardware · Safety · Security · Privacy · Verification&#10;~56 classes · 45 object props · 37 axioms"><mxGeometry x="60" y="160" width="640" height="200" as="geometry"/></mxCell>
        <mxCell id="p6_proc" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" value="@memo/ontology-process&#10;&#10;Regulatory process activities + work products&#10;ISO 14971 · IEC 62304 · ISO 13485 · IEC 60601 · ISO 14155 · ISO 27001/27701 · FDA 21 CFR 820 · EU MDR&#10;Bridges to arch via producesEvidence / tracedTo"><mxGeometry x="800" y="160" width="640" height="200" as="geometry"/></mxCell>

        <!-- Middle: profile -->
        <mxCell id="p6_prof" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" value="@memo/medical-modeling-profile&#10;&#10;Modeling profile · extends both ontology packages&#10;35+ closure rules · viewpoints (Risk · Requirements · Architecture · Software · V&amp;V · DHF) · guided workflows · starter templates"><mxGeometry x="380" y="470" width="740" height="160" as="geometry"/></mxCell>

        <!-- Bottom: device project -->
        <mxCell id="p6_dev" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" value="Device Project&#10;memo.config.yaml: ontologies: [&quot;@memo/medical-modeling-profile&quot;]"><mxGeometry x="500" y="730" width="500" height="80" as="geometry"/></mxCell>

        <!-- Side: ontology-loader -->
        <mxCell id="p6_load" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;dashed=1;" value="core.ontologyLoader&#10;discover · merge · expose"><mxGeometry x="60" y="490" width="240" height="80" as="geometry"/></mxCell>

