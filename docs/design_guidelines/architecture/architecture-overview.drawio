        <mxCell id="p6e2" parent="1" edge="1" source="p6_arch" target="p6_prof" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;" value="extends"><mxGeometry relative="1" as="geometry"/></mxCell>
