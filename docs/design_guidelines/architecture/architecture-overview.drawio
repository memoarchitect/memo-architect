  <diagram id="L3" name="L3 — Edit round-trip">
    <mxGraphModel dx="1500" dy="1700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p7_title" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;" value="L3 — Element Edit Round-Trip"><mxGeometry x="40" y="20" width="1420" height="32" as="geometry"/></mxCell>
        <mxCell id="p7_sub" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=2;fontColor=#555555;" value="Numbered top-down: browser edit → WebSocket → .sysml patch → re-parse → broadcast → UI re-render. Filesystem is the source of truth."><mxGeometry x="40" y="56" width="1420" height="22" as="geometry"/></mxCell>

        <!-- Lane labels -->
        <mxCell id="p7_lane_b" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#999999;rotation=-90;" value="BROWSER"><mxGeometry x="40" y="200" width="60" height="200" as="geometry"/></mxCell>
        <mxCell id="p7_lane_s" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#999999;rotation=-90;" value="SERVER"><mxGeometry x="40" y="540" width="60" height="200" as="geometry"/></mxCell>
        <mxCell id="p7_lane_f" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#999999;rotation=-90;" value="FILESYSTEM"><mxGeometry x="40" y="760" width="60" height="100" as="geometry"/></mxCell>
        <mxCell id="p7_lane_p" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#999999;rotation=-90;" value="PIPELINE"><mxGeometry x="40" y="900" width="60" height="320" as="geometry"/></mxCell>
        <mxCell id="p7_lane_b2" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#999999;rotation=-90;" value="BROWSER"><mxGeometry x="40" y="1370" width="60" height="240" as="geometry"/></mxCell>

        <!-- Steps (centred x=350 w=800) -->
        <mxCell id="p7_s1" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" value="1. elementDetailView&#10;user edits an attribute"><mxGeometry x="350" y="120" width="800" height="80" as="geometry"/></mxCell>
        <mxCell id="p7_s2" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" value="2. modelStore.applyEdit (optimistic local update)"><mxGeometry x="350" y="230" width="800" height="80" as="geometry"/></mxCell>
