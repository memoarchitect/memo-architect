  <diagram id="extension-model" name="04-apply-and-extend">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t_extension-model" value="&lt;b&gt;04. Apply First. Extend Only When Needed.&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:13px;color:#4d4d4d&#x27;&gt;Most projects select a methodology and instantiate the canonical ontology. New domain packages are an explicit, optional variation point.&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=20;" vertex="1" parent="1"><mxGeometry x="50" y="24" width="1554" height="70" as="geometry"/></mxCell>
        <mxCell id="b0_extension-model" value="&lt;b&gt;Canonical ontology — versioned &amp; stable&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontStyle=1;align=left;fillColor=#eef3fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#1f2933;swimlaneFillColor=#eef3fc;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="138" width="1554" height="190" as="geometry"/></mxCell>
        <mxCell id="b0_extension-model_n0" value="&lt;b&gt;@memo/ontology&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;shared medical-device concepts · architecture · compliance · artifacts · viewpoints · typed relationships · invariant rules&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="b0_extension-model"><mxGeometry x="18" y="40" width="1518" height="136" as="geometry"/></mxCell>
        <mxCell id="b1_extension-model" value="&lt;b&gt;Consume&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontStyle=1;align=left;fillColor=#fff6da;strokeColor=#d6b656;fontSize=13;fontColor=#1f2933;swimlaneFillColor=#fff6da;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="368" width="1554" height="190" as="geometry"/></mxCell>
        <mxCell id="b1_extension-model_n0" value="&lt;b&gt;Tailor with methodology&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;choose layers &amp; standards · hide unused kinds / docs · adjust workflow, viewpoints, aliases, rule strength   —   use when the vocabulary already exists&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="b1_extension-model"><mxGeometry x="18" y="40" width="748" height="136" as="geometry"/></mxCell>
        <mxCell id="b1_extension-model_n1" value="&lt;b&gt;Add an extension package&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;@memo/ext-* · namespace memo::ontology::ext::&lt;id&gt;::* · specialize canonical kinds + focused rules / views   —   use when a real domain concept is missing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="b1_extension-model"><mxGeometry x="788" y="40" width="748" height="136" as="geometry"/></mxCell>
