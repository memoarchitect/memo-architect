        <mxCell id="c1_extension-model" value="pinned by  ▼" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#444444;fontSize=11;fontStyle=1;fontColor=#1f2933;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b1_extension-model" target="b2_extension-model"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c2_extension-model" value="instantiated by  ▼" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#444444;fontSize=11;fontStyle=1;fontColor=#1f2933;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b2_extension-model" target="b3_extension-model"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note_extension-model" value="&lt;b&gt;Note&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&#x27;font-size:12px&#x27;&gt;Decision rule: methodology authors select &amp; sequence; project authors instantiate; extension authors specialize only when the shared vocabulary truly lacks a reusable concept.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontColor=#1f2933;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="50" y="1048" width="1554" height="74" as="geometry"/></mxCell>
