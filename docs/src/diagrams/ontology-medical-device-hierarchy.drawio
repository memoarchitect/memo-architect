<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="memo-purpose" name="01-why-memo">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t_memo-purpose" value="&lt;b&gt;01. Why MEMO Exists&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:13px;color:#4d4d4d&#x27;&gt;Medical-device engineering needs a living, reviewable safety argument — not a stack of documents that drift apart.&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=20;" vertex="1" parent="1"><mxGeometry x="50" y="24" width="1554" height="70" as="geometry"/></mxCell>
        <mxCell id="b0_memo-purpose" value="&lt;b&gt;The recurring problem&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontStyle=1;align=left;fillColor=#fbeeee;strokeColor=#b85450;fontSize=13;fontColor=#1f2933;swimlaneFillColor=#fbeeee;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="186" width="1554" height="190" as="geometry"/></mxCell>
        <mxCell id="b0_memo-purpose_n0" value="&lt;b&gt;Architecture diagrams&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="b0_memo-purpose"><mxGeometry x="18" y="40" width="363" height="136" as="geometry"/></mxCell>
        <mxCell id="b0_memo-purpose_n1" value="&lt;b&gt;Requirements &amp; risk spreadsheets&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="b0_memo-purpose"><mxGeometry x="403" y="40" width="363" height="136" as="geometry"/></mxCell>
        <mxCell id="b0_memo-purpose_n2" value="&lt;b&gt;Verification evidence &amp; test reports&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="b0_memo-purpose"><mxGeometry x="788" y="40" width="363" height="136" as="geometry"/></mxCell>
        <mxCell id="b0_memo-purpose_n3" value="&lt;b&gt;DHF documents &amp; audit packets&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="b0_memo-purpose"><mxGeometry x="1173" y="40" width="363" height="136" as="geometry"/></mxCell>
        <mxCell id="b1_memo-purpose" value="&lt;b&gt;The drift&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontStyle=1;align=left;fillColor=#fbeeee;strokeColor=#b85450;fontSize=13;fontColor=#1f2933;swimlaneFillColor=#fbeeee;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="416" width="1554" height="190" as="geometry"/></mxCell>
        <mxCell id="b1_memo-purpose_n0" value="&lt;b&gt;Which evidence is still valid?  Which hazards changed?  Which documents must be regenerated?&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Disconnected artifacts cannot answer change-impact questions.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="b1_memo-purpose"><mxGeometry x="18" y="40" width="1518" height="136" as="geometry"/></mxCell>
        <mxCell id="b2_memo-purpose" value="&lt;b&gt;MEMO&#x27;s purpose&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontStyle=1;align=left;fillColor=#eef7ec;strokeColor=#82b366;fontSize=13;fontColor=#1f2933;swimlaneFillColor=#eef7ec;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="646" width="1554" height="190" as="geometry"/></mxCell>
        <mxCell id="b2_memo-purpose_n0" value="&lt;b&gt;Model the system as code&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;SysML v2 is the single engineering format&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="b2_memo-purpose"><mxGeometry x="18" y="40" width="491" height="136" as="geometry"/></mxCell>
        <mxCell id="b2_memo-purpose_n1" value="&lt;b&gt;Connect architecture to assurance&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;needs · hazards · controls · requirements · design · tests · evidence form one graph&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="b2_memo-purpose"><mxGeometry x="531" y="40" width="491" height="136" as="geometry"/></mxCell>
        <mxCell id="b2_memo-purpose_n2" value="&lt;b&gt;Generate review-ready views&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;diagrams · compliance surfaces · DHF artifacts are projections of the living model&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="b2_memo-purpose"><mxGeometry x="1044" y="40" width="491" height="136" as="geometry"/></mxCell>
        <mxCell id="b3_memo-purpose" value="&lt;b&gt;Desired outcome&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontStyle=1;align=left;fillColor=#eef3fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#1f2933;swimlaneFillColor=#eef3fc;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="876" width="1554" height="190" as="geometry"/></mxCell>
        <mxCell id="b3_memo-purpose_n0" value="&lt;b&gt;Ask the model what is affected, what no longer closes, and what evidence must be refreshed.&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Change becomes a query, not an archaeology project.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="b3_memo-purpose"><mxGeometry x="18" y="40" width="1518" height="136" as="geometry"/></mxCell>
        <mxCell id="c0_memo-purpose" value="a design change lands  ▼" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#444444;fontSize=11;fontStyle=1;fontColor=#1f2933;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b0_memo-purpose" target="b1_memo-purpose"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c1_memo-purpose" value="MEMO&#x27;s response  ▼" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#444444;fontSize=11;fontStyle=1;fontColor=#1f2933;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b1_memo-purpose" target="b2_memo-purpose"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c2_memo-purpose" value="produces  ▼" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#444444;fontSize=11;fontStyle=1;fontColor=#1f2933;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b2_memo-purpose" target="b3_memo-purpose"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="memo-ecosystem" name="02-three-product-parts">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t_memo-ecosystem" value="&lt;b&gt;02. MEMO Has Three Product Parts&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:13px;color:#4d4d4d&#x27;&gt;Portable domain content, automation, and user experience — each with one responsibility. Foundation on top; everything builds downward.&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=20;" vertex="1" parent="1"><mxGeometry x="50" y="24" width="1554" height="70" as="geometry"/></mxCell>
        <mxCell id="b0_memo-ecosystem" value="&lt;b&gt;Foundation — portable SysML v2 content&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontStyle=1;align=left;fillColor=#fff6da;strokeColor=#d6b656;fontSize=13;fontColor=#1f2933;swimlaneFillColor=#fff6da;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="138" width="1554" height="190" as="geometry"/></mxCell>
        <mxCell id="b0_memo-ecosystem_n0" value="&lt;b&gt;memo&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;formerly memo-sysmlv2 · base helpers · ontology · methodology · viewpoints · views · rules · examples · no TypeScript · defines what medical-device modeling means&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="b0_memo-ecosystem"><mxGeometry x="18" y="40" width="1518" height="136" as="geometry"/></mxCell>
        <mxCell id="b1_memo-ecosystem" value="&lt;b&gt;Engine — automation&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontStyle=1;align=left;fillColor=#eef3fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#1f2933;swimlaneFillColor=#eef3fc;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="368" width="1554" height="190" as="geometry"/></mxCell>
        <mxCell id="b1_memo-ecosystem_n0" value="&lt;b&gt;memo-tools&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;the CLI · Langium parser · semantic model builder · KerML evaluator · validation · completeness · import / export · dev server · WebSocket&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="b1_memo-ecosystem"><mxGeometry x="18" y="40" width="1518" height="136" as="geometry"/></mxCell>
        <mxCell id="b2_memo-ecosystem" value="&lt;b&gt;Experience — guided UI&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontStyle=1;align=left;fillColor=#eef7ec;strokeColor=#82b366;fontSize=13;fontColor=#1f2933;swimlaneFillColor=#eef7ec;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="598" width="1554" height="190" as="geometry"/></mxCell>
        <mxCell id="b2_memo-ecosystem_n0" value="&lt;b&gt;memo-architect&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;the web app · browser UI · viewpoint filtering · diagrams · dashboards · artifact &amp; compliance surfaces&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="b2_memo-ecosystem"><mxGeometry x="18" y="40" width="1518" height="136" as="geometry"/></mxCell>
        <mxCell id="b3_memo-ecosystem" value="&lt;b&gt;Users &amp; project&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontStyle=1;align=left;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontColor=#1f2933;swimlaneFillColor=#f5f5f5;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="828" width="1554" height="190" as="geometry"/></mxCell>
        <mxCell id="b3_memo-ecosystem_n0" value="&lt;b&gt;Medical-device team&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;systems · safety · software · reviewers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="b3_memo-ecosystem"><mxGeometry x="18" y="40" width="748" height="136" as="geometry"/></mxCell>
        <mxCell id="b3_memo-ecosystem_n1" value="&lt;b&gt;Device project&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;.sysml files + memo.config.yaml — pins a methodology, holds concrete instances&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="b3_memo-ecosystem"><mxGeometry x="788" y="40" width="748" height="136" as="geometry"/></mxCell>
