        <mxCell id="b2_extension-model_n0" value="&lt;b&gt;IVD extension&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;memo::ontology::ext::ivd::*&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="b2_extension-model"><mxGeometry x="18" y="40" width="748" height="136" as="geometry"/></mxCell>
        <mxCell id="b2_extension-model_n1" value="&lt;b&gt;Surgical-robotics extension&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;memo::ontology::ext::surgical_robotics::*&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="b2_extension-model"><mxGeometry x="788" y="40" width="748" height="136" as="geometry"/></mxCell>
        <mxCell id="b3_extension-model" value="&lt;b&gt;Project model&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontStyle=1;align=left;fillColor=#eef7ec;strokeColor=#82b366;fontSize=13;fontColor=#1f2933;swimlaneFillColor=#eef7ec;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="828" width="1554" height="190" as="geometry"/></mxCell>
        <mxCell id="b3_extension-model_n0" value="&lt;b&gt;Project model&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;pins ontology, methodology, and optional extension versions · holds usages &amp; project exemptions, not shared type definitions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="b3_extension-model"><mxGeometry x="18" y="40" width="1518" height="136" as="geometry"/></mxCell>
