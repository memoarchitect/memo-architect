        <mxCell id="t_assurance-closure" value="&lt;b&gt;12. Assurance &amp; Closure — Proving the Argument&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:13px;color:#4d4d4d&#x27;&gt;Verification produces evidence; evidence closes requirements, controls, and software classes; compliance records persist the result.&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=20;" vertex="1" parent="1"><mxGeometry x="50" y="24" width="1554" height="70" as="geometry"/></mxCell>
