  <diagram id="methodology-workflow" name="15-methodology">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t_methodology-workflow" value="&lt;b&gt;15. Methodology — Pick, Sequence, and Gate the Work&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:13px;color:#4d4d4d&#x27;&gt;A methodology selects an ontology subset (additive includes + explicit excludes), sequences the work, and gates quality. Archetypes are presets.&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=20;" vertex="1" parent="1"><mxGeometry x="50" y="24" width="1554" height="70" as="geometry"/></mxCell>
        <mxCell id="b0_methodology-workflow" value="&lt;b&gt;Methodology core&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontStyle=1;align=left;fillColor=#fff6da;strokeColor=#d6b656;fontSize=13;fontColor=#1f2933;swimlaneFillColor=#fff6da;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="138" width="1554" height="190" as="geometry"/></mxCell>
        <mxCell id="b0_methodology-workflow_n0" value="&lt;b&gt;MethodologyLibrary · Archetype · MethodologyScope · ResolvedMethodology&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;the tailoring vocabulary, all expressed in SysML v2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="b0_methodology-workflow"><mxGeometry x="18" y="40" width="1518" height="136" as="geometry"/></mxCell>
        <mxCell id="b1_methodology-workflow" value="&lt;b&gt;7 Archetypes (presets)&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontStyle=1;align=left;fillColor=#fff6da;strokeColor=#d6b656;fontSize=13;fontColor=#1f2933;swimlaneFillColor=#fff6da;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="368" width="1554" height="190" as="geometry"/></mxCell>
        <mxCell id="b1_methodology-workflow_n0" value="&lt;b&gt;Blank&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;no layers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="b1_methodology-workflow"><mxGeometry x="18" y="40" width="286" height="136" as="geometry"/></mxCell>
        <mxCell id="b1_methodology-workflow_n1" value="&lt;b&gt;Minimal&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;context · req · risk / ISO 14971&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="b1_methodology-workflow"><mxGeometry x="326" y="40" width="286" height="136" as="geometry"/></mxCell>
        <mxCell id="b1_methodology-workflow_n2" value="&lt;b&gt;Standard&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;+ functions · logical · SW · assurance&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="b1_methodology-workflow"><mxGeometry x="634" y="40" width="286" height="136" as="geometry"/></mxCell>
        <mxCell id="b1_methodology-workflow_n3" value="&lt;b&gt;Full&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;14 layers / 9 standards&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="b1_methodology-workflow"><mxGeometry x="942" y="40" width="286" height="136" as="geometry"/></mxCell>
        <mxCell id="b1_methodology-workflow_n4" value="&lt;b&gt;SaMD · Connected · Monitoring · Infusion Pump&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;specialized presets&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="b1_methodology-workflow"><mxGeometry x="1250" y="40" width="286" height="136" as="geometry"/></mxCell>
