        <mxCell id="b1_ontology-package-map" value="&lt;b&gt;architecture/  +  compliance/  +  artifacts/   — domain meaning&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontStyle=1;align=left;fillColor=#eef5ff;strokeColor=#6c8ebf;fontSize=13;fontColor=#1f2933;swimlaneFillColor=#eef5ff;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="311" width="1554" height="151" as="geometry"/></mxCell>
        <mxCell id="b1_ontology-package-map_n0" value="&lt;b&gt;architecture/  (17 sub-packages)&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;context · operational · system · functions · logical · behavior · software · hardware · physical · risk · cyber · assurance · analysis · constraints · decisions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="b1_ontology-package-map"><mxGeometry x="18" y="40" width="748" height="97" as="geometry"/></mxCell>
        <mxCell id="b1_ontology-package-map_n1" value="&lt;b&gt;compliance/  +  artifacts/&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;ISO 14971 RMF · controlled artifacts · change management · post-market records&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="b1_ontology-package-map"><mxGeometry x="788" y="40" width="748" height="97" as="geometry"/></mxCell>
