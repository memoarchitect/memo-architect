  <diagram id="gpca-risk-thread" name="16-gpca-worked-thread">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t_gpca-risk-thread" value="&lt;b&gt;16. Worked Thread — One Overdose Risk Through the GPCA Pump&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:13px;color:#4d4d4d&#x27;&gt;Follow a single safety thread top to bottom: intent → requirement → design → hazard → control → verification → evidence → document.&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=20;" vertex="1" parent="1"><mxGeometry x="50" y="24" width="1554" height="70" as="geometry"/></mxCell>
        <mxCell id="b0_gpca-risk-thread" value="&lt;b&gt;Intent&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontStyle=1;align=left;fillColor=#eef5ff;strokeColor=#6c8ebf;fontSize=13;fontColor=#1f2933;swimlaneFillColor=#eef5ff;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="123" width="1554" height="91" as="geometry"/></mxCell>
        <mxCell id="b0_gpca-risk-thread_n0" value="&lt;b&gt;IntendedUse&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;deliver a programmed dose of IV medication to a patient&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="b0_gpca-risk-thread"><mxGeometry x="18" y="40" width="1518" height="37" as="geometry"/></mxCell>
        <mxCell id="b1_gpca-risk-thread" value="&lt;b&gt;Requirement&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontStyle=1;align=left;fillColor=#fff4e6;strokeColor=#d79b00;fontSize=13;fontColor=#1f2933;swimlaneFillColor=#fff4e6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="240" width="1554" height="91" as="geometry"/></mxCell>
        <mxCell id="b1_gpca-risk-thread_n0" value="&lt;b&gt;SoftwareRequirement&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;limit delivered dose to the programmed rate within tolerance&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="b1_gpca-risk-thread"><mxGeometry x="18" y="40" width="1518" height="37" as="geometry"/></mxCell>
        <mxCell id="b2_gpca-risk-thread" value="&lt;b&gt;Design&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontStyle=1;align=left;fillColor=#eef5ff;strokeColor=#6c8ebf;fontSize=13;fontColor=#1f2933;swimlaneFillColor=#eef5ff;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="357" width="1554" height="91" as="geometry"/></mxCell>
        <mxCell id="b2_gpca-risk-thread_n0" value="&lt;b&gt;SoftwareComponent: DoseRateController&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;AllocatesFunction: regulate flow rate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="b2_gpca-risk-thread"><mxGeometry x="18" y="40" width="1518" height="37" as="geometry"/></mxCell>
        <mxCell id="b3_gpca-risk-thread" value="&lt;b&gt;Hazard&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontStyle=1;align=left;fillColor=#fbeeee;strokeColor=#b85450;fontSize=13;fontColor=#1f2933;swimlaneFillColor=#fbeeee;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="474" width="1554" height="91" as="geometry"/></mxCell>
        <mxCell id="b3_gpca-risk-thread_n0" value="&lt;b&gt;Hazard: overdose&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;HazardousSituation: free-flow → Harm: patient injury&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="b3_gpca-risk-thread"><mxGeometry x="18" y="40" width="1518" height="37" as="geometry"/></mxCell>
        <mxCell id="b4_gpca-risk-thread" value="&lt;b&gt;Control&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontStyle=1;align=left;fillColor=#fbeeee;strokeColor=#b85450;fontSize=13;fontColor=#1f2933;swimlaneFillColor=#fbeeee;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="591" width="1554" height="91" as="geometry"/></mxCell>
        <mxCell id="b4_gpca-risk-thread_n0" value="&lt;b&gt;RiskControl&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;hardware occluder + software rate guard   (Mitigates)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="b4_gpca-risk-thread"><mxGeometry x="18" y="40" width="1518" height="37" as="geometry"/></mxCell>
        <mxCell id="b5_gpca-risk-thread" value="&lt;b&gt;Verification&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontStyle=1;align=left;fillColor=#eef7ec;strokeColor=#82b366;fontSize=13;fontColor=#1f2933;swimlaneFillColor=#eef7ec;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="708" width="1554" height="91" as="geometry"/></mxCell>
