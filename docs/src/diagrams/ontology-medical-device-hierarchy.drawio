        <mxCell id="t_ontology-package-map" value="&lt;b&gt;03. Inside memo: Package Composition&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:13px;color:#4d4d4d&#x27;&gt;Open the content product top-down: shared language first, then domain meaning, then presentation and checks, then method, then proof.&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=20;" vertex="1" parent="1"><mxGeometry x="50" y="24" width="1554" height="70" as="geometry"/></mxCell>
        <mxCell id="b0_ontology-package-map" value="&lt;b&gt;base/  +  core/   — shared language&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontStyle=1;align=left;fillColor=#eef3fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#1f2933;swimlaneFillColor=#eef3fc;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="120" width="1554" height="151" as="geometry"/></mxCell>
        <mxCell id="b0_ontology-package-map_n0" value="&lt;b&gt;base/&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;KerML stdlib wrapper · dimensions · semantics · methodology &amp; rule base types&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="b0_ontology-package-map"><mxGeometry x="18" y="40" width="748" height="97" as="geometry"/></mxCell>
