        <mxCell id="seq_methodology-workflow_3" value="" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="b2_methodology-workflow_n2" target="b2_methodology-workflow_n3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b3_methodology-workflow" value="&lt;b&gt;Project binding&lt;/b&gt;" style="swimlane;startSize=30;html=1;fontStyle=1;align=left;fillColor=#eef7ec;strokeColor=#82b366;fontSize=13;fontColor=#1f2933;swimlaneFillColor=#eef7ec;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="828" width="1554" height="190" as="geometry"/></mxCell>
        <mxCell id="b3_methodology-workflow_n0" value="&lt;b&gt;ProjectMethodBinding&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;pins @memo/methodology-* · the GPCA variant subtracts cybersecurity + SOUP for a non-networked prototype&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="b3_methodology-workflow"><mxGeometry x="18" y="40" width="1518" height="136" as="geometry"/></mxCell>
