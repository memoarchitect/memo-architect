  <diagram id="deep-critique" name="Expert Critique">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="dc-title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" value="Harsh Expert Critique (SysML v2 + Architecture Ontology)" vertex="1"><mxGeometry x="40" y="20" width="980" height="40" as="geometry" /></mxCell>

        <mxCell id="dc-h1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#E6E6E6;strokeColor=#666666;align=center;" value="Issue" vertex="1"><mxGeometry x="40" y="80" width="260" height="30" as="geometry" /></mxCell>
        <mxCell id="dc-h2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#E6E6E6;strokeColor=#666666;align=center;" value="Why This Is Bad" vertex="1"><mxGeometry x="300" y="80" width="500" height="30" as="geometry" /></mxCell>
        <mxCell id="dc-h3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#E6E6E6;strokeColor=#666666;align=center;" value="Correction In v4" vertex="1"><mxGeometry x="800" y="80" width="540" height="30" as="geometry" /></mxCell>

        <mxCell id="dc1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" value="No real system/software backbone"><mxGeometry x="40" y="110" width="260" height="76" as="geometry" /></mxCell>
        <mxCell id="dc2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" value="Without SoftwareSystem/Subsystem/Component/Service/Thread and Hardware Processor/Sensor/Actuator/Bus, the model cannot represent concrete architecture." vertex="1"><mxGeometry x="300" y="110" width="500" height="76" as="geometry" /></mxCell>
        <mxCell id="dc3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" value="Added explicit multi-level system+software+hardware class sets in ontology-core and constrained medical specializations in ontology-medical-architecture." vertex="1"><mxGeometry x="800" y="110" width="540" height="76" as="geometry" /></mxCell>

        <mxCell id="dc4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" value="Category error: mixing attributes/relationships as elements"><mxGeometry x="40" y="186" width="260" height="86" as="geometry" /></mxCell>
        <mxCell id="dc5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" value="A relationship (e.g., allocatedTo) is an object property, not a class. An attribute (e.g., criticality) is a data property, not a class. Mixing them breaks ontology semantics." vertex="1"><mxGeometry x="300" y="186" width="500" height="86" as="geometry" /></mxCell>
        <mxCell id="dc6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" value="Tab 1 now contains classes only. Relationships are isolated to Tab 3; attributes are defined as property contracts (Tab 3), not nodes." vertex="1"><mxGeometry x="800" y="186" width="540" height="86" as="geometry" /></mxCell>

        <mxCell id="dc7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" value="Weak core/medical separation"><mxGeometry x="40" y="272" width="260" height="76" as="geometry" /></mxCell>
        <mxCell id="dc8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" value="If medical semantics leak into core, reuse across non-medical mechatronics fails and governance collapses." vertex="1"><mxGeometry x="300" y="272" width="500" height="76" as="geometry" /></mxCell>
        <mxCell id="dc9" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" value="Renamed and re-bounded columns: ontology-core generic; ontology-medical-architecture is specialization-only." vertex="1"><mxGeometry x="800" y="272" width="540" height="76" as="geometry" /></mxCell>

        <mxCell id="dc10" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" value="Medical domain not expressive enough"><mxGeometry x="40" y="348" width="260" height="86" as="geometry" /></mxCell>
        <mxCell id="dc11" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" value="Generic terms alone cannot model intended use, contraindications, essential performance, applied part isolation, or clinical evidence." vertex="1"><mxGeometry x="300" y="348" width="500" height="86" as="geometry" /></mxCell>
        <mxCell id="dc12" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" value="Added explicit medical-only elements per layer: ClinicalUseContext, IntendedUse, Contraindication, Therapy/Alarm/Safety functions, AppliedPart, EssentialPerformanceEvidence, etc." vertex="1"><mxGeometry x="800" y="348" width="540" height="86" as="geometry" /></mxCell>

        <mxCell id="dc13" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" value="Traceability obligations were not enforceable"><mxGeometry x="40" y="434" width="260" height="76" as="geometry" /></mxCell>
        <mxCell id="dc14" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" value="A pretty trace line is meaningless unless required by constraints (release gating, risk closure conditions)." vertex="1"><mxGeometry x="300" y="434" width="500" height="76" as="geometry" /></mxCell>
        <mxCell id="dc15" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" value="Tab 3 declares mandatory constraints: released requirements require evidence; closed risks require mitigation + verification." vertex="1"><mxGeometry x="800" y="434" width="540" height="76" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

