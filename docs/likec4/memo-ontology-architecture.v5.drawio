        <mxCell id="rp11" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" value="LogicalComponent"><mxGeometry x="40" y="166" width="260" height="28" as="geometry" /></mxCell>
        <mxCell id="rp12" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" value="realizedBy"><mxGeometry x="300" y="166" width="220" height="28" as="geometry" /></mxCell>
        <mxCell id="rp13" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" value="SoftwareComponent / HardwareComponent"><mxGeometry x="520" y="166" width="260" height="28" as="geometry" /></mxCell>
