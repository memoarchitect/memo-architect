        <mxCell id="rp6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" value="SystemFunction"><mxGeometry x="40" y="138" width="260" height="28" as="geometry" /></mxCell>
        <mxCell id="rp7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" value="allocatedTo"><mxGeometry x="300" y="138" width="220" height="28" as="geometry" /></mxCell>
        <mxCell id="rp8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" value="LogicalComponent"><mxGeometry x="520" y="138" width="260" height="28" as="geometry" /></mxCell>
        <mxCell id="rp9" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" value="1..* for safety-critical function"><mxGeometry x="780" y="138" width="260" height="28" as="geometry" /></mxCell>
