        <mxCell id="s_r1d" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;" value="sourceStandard, regulatoryReference, criticality, status. Add disjointness axioms to avoid unsatisfiable class overlap." vertex="1"><mxGeometry x="840" y="110" width="500" height="95" as="geometry" /></mxCell>

