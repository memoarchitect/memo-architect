# Dependencies
node_modules/
.pnpm-store/

# Guard against a nested checkout reappearing. Architect consumes
# @memoarchitect/tools and @memoarchitect/ontology from npm; the memo-meta
# workspace links the sibling repos for cross-repo work. Neither is a submodule.
/memo-tools/
/memo/

# Claude Code worktrees (internal)
.claude/worktrees/

# Build outputs
dist/
dist-standalone/
lib/
out/
*.tsbuildinfo

# `lib/` above is a build output directory, and it silently swallowed the web
# app's own `src/lib` — three modules the explorer imports were ignored rather
# than committed, so a fresh clone could not build. Source is not build output.
!packages/web/src/lib/

# Generated (Langium)
packages/core/src/language/generated/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Turbo
.turbo/

# Test
coverage/

# Layouts (auto-generated, optional to version)
.memo/layouts/

# SysAnd local cache + generated build metadata
.sysand/
sysand_env/
# .meta.json is regenerated deterministically by scripts/sysand-portability-check.sh
.meta.json
output/

# Local feedback
feedback/

# Built kpar archives
*.kpar

# Generated TextMate grammar
packages/core/syntaxes/

# Roadmap plans are tracked docs, not generated GitLab truth.
.claude/settings.local.json

# LLM credentials — never commit an API key
.env
.env.local

# Python (pdm / mkdocs) — the docs site toolchain, identical in memo,
# memo-tools and memo-architect. pdm.lock and .python-version ARE committed;
# .pdm-python is not, because it holds an absolute path to one machine.
.venv/
venv/
__pypackages__/
__pycache__/
*.egg-info/
.pdm-python

# Generated documentation site
site/
public/
_site/

# Isolated browser fixtures, sidecars and evidence
/artifacts/
/playwright-report/

# Generated instrumented diagnostic copies, regenerated by tests/browser/generate-undo-diagnostic.mjs
/packages/web/pilot-baseline/undo-diagnostic/
