{
  "name": "@memoarchitect/architect",
  "version": "0.8.11",
  "description": "MEMO Architect \u2014 interactive workbench and distributable viewer for medical device systems engineering",
  "type": "module",
  "bin": {
    "memo-architect": "lib/bin/memo-architect.js"
  },
  "exports": {
    "./package.json": "./package.json",
    "./dist": "./dist/index.html"
  },
  "files": [
    "dist/",
    "dist-standalone/",
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm run generate:notation && pnpm run check:cache && pnpm run build:client && pnpm run check:bundle && pnpm run build:client:standalone && pnpm run build:cli",
    "generate:notation": "node scripts/generate-notation-registry.mjs",
    "prepack": "pnpm run clean && pnpm run build",
    "build:client": "vite build --config packages/web/vite.config.ts",
    "build:client:standalone": "vite build --config packages/web/vite.standalone.config.ts",
    "build:cli": "tsc -p tsconfig.architect.json",
    "check:cache": "bash scripts/check-no-ontology-cache.sh",
    "check:bundle": "bash scripts/check-no-bare-imports.sh",
    "dev": "pnpm run example:dev",
    "dev:web": "vite --config packages/web/vite.config.ts",
    "test": "pnpm run test:web && pnpm run test:cli",
    "test:coverage": "cd packages/web && vitest run --coverage",
    "type-check": "tsc -p packages/web/tsconfig.json --noEmit && tsc -p tsconfig.architect.json --noEmit",
    "clean": "rm -rf dist dist-standalone lib",
    "docs:serve": "pdm run docs-serve",
    "docs:build": "pdm run docs-build",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "architect": "node lib/bin/memo-architect.js",
    "example:dev": "node scripts/run-gpca-example.mjs",
    "setup": "pnpm install && pnpm run build && pdm install",
    "test:web": "cd packages/web && vitest run",
    "test:cli": "vitest run --config vitest.cli.config.ts"
  },
  "dependencies": {
    "@memoarchitect/ontology": "0.8.1",
    "@memoarchitect/tools": "0.8.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^12.1.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^2.0.0",
    "@maxgraph/core": "^0.24.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.1.0",
    "@xyflow/react": "^12.3.0",
    "autoprefixer": "^10.4.20",
    "elkjs": "^0.9.3",
    "jsdom": "^29.1.1",
    "libavoid-js": "0.5.0-beta.5",
    "monaco-editor": "^0.55.1",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.2",
    "tailwindcss": "^4.0.0",
    "turbo": "^2.3.0",
    "typescript": "~5.5.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "zustand": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/memoarchitect/memo-architect.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=26.0.0"
  }
}
